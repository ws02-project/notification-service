{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Automerge all updates (minor, patch, and major)",
      "matchUpdateTypes": ["minor", "patch", "major"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Group all non-major updates together",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch"
    },
    {
      "description": "Do not automerge Express - requires manual testing",
      "matchPackageNames": ["express", "@types/express"],
      "automerge": false,
      "labels": ["dependencies", "express", "manual-review"]
    },
    {
      "description": "Do not automerge Node.js - requires compatibility testing",
      "matchDepTypes": ["engines"],
      "matchPackageNames": ["node"],
      "automerge": false,
      "labels": ["dependencies", "nodejs", "manual-review"]
    },
    {
      "description": "Do not automerge Node.js Docker image updates",
      "matchDatasources": ["docker"],
      "matchPackagePatterns": ["^node$", "node:"],
      "automerge": false,
      "labels": ["dependencies", "nodejs", "manual-review"]
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "automerge": true
  }
}
